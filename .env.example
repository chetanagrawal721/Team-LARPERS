# Copy to .env and fill in. NEVER commit .env.
# Per-agent HMAC signing keys (demo values only)
AGENT_KEY_REFUND_AGENT=change-me-refund
AGENT_KEY_OPS_AGENT=change-me-ops
AGENT_KEY_RECORDS_AGENT=change-me-records
AGENT_KEY_SUPPORT_AGENT=change-me-support
AGENT_KEY_MARKETING_AGENT=change-me-marketing
# Gateway seal-signing key
GATEWAY_SEAL_KEY=change-me-seal
# Demo user tokens (demo-only auth)
USER_TOKEN_PRIYA=change-me-priya
USER_TOKEN_RAHUL=change-me-rahul
USER_TOKEN_MEERA=change-me-meera
# AI (optional; empty = fallback mode). Providers: none | ollama | gemini | openrouter
AI_ENABLED=true
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
OLLAMA_URL=http://localhost:11434
